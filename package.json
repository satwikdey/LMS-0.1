{
  "name": "school-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Single-school public website and role-based portal (Next.js, Supabase Auth, Prisma, PostgreSQL)",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "rollup": "4.64.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:local": "tsx scripts/local-db.ts",
    "daily": "tsx scripts/run-daily.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "demo": "python scripts/record_client_demo.py --url http://localhost:3005",
    "demo:headless": "python scripts/record_client_demo.py --url http://localhost:3005 --headless",
    "demo:record": "python scripts/record_client_demo.py --url http://localhost:3005 --output 5_Point_Engineering_LMS_Client_Demo.mp4",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "clsx": "2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "0.460.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.15.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "20.17.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "dotenv": "^16.4.5",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "prisma": "5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vitest": "2.1.9"
  }
}
